# =====================================================================
# REQUIRED: where the scraping repo is cloned locally.
# The agent reads runner configs / spider source / git history from here.
# =====================================================================
SCRAPING_REPO_ROOT=/Users/satwikkumar/Desktop/GobbleCube/scraping

# LLM
ANTHROPIC_API_KEY=
RCA_LLM_MODEL=claude-sonnet-4-5-20250929

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...        # only needed for Socket Mode (slash command)
SLACK_SIGNING_SECRET=...         # only needed for Slack HTTP events

# ClickUp
CLICKUP_API_TOKEN=pk_...

# GitHub (draft PR target — usually the scraping repo)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=GobbleCube/scraping
GITHUB_DEFAULT_BASE_BRANCH=main

# ---------------------------------------------------------------------
# The following are read directly from the scraping repo's .env if present.
# Set them here only to override.
# ---------------------------------------------------------------------

# Snowflake (key-pair auth via the scraping repo's existing client)
SF_USER=
SF_ACCOUNT=
SF_RSA_KEY=
SF_RSA_KEY_PASSWORD=
SF_WAREHOUSE=
SF_DATABASE=
SF_ROLE=                         # use a READ-ONLY role for safety

# Postgres
DB_HOST=
DB_PORT=5432
DB_NAME=scraping
DB_USERNAME=
DB_PASSWORD=

# AWS S3 (raw response artifacts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Temporal (optional — for workflow history)
TEMPORAL_HOST=
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# RCA agent runtime
RCA_TOOL_BUDGET=25
RCA_SF_STATEMENT_TIMEOUT_S=60
RCA_SF_DEFAULT_LIMIT=200
RCA_PG_DEFAULT_LIMIT=200
RCA_AUTO_PR_MIN_CONFIDENCE=0.75
RCA_LOG_DIR=runs/logs
